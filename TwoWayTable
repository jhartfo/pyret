# misc statistical functions

fun factorial(n):
  if n == 0: 1
  else if n == 1: 1
  else:
    n * factorial(n - 1)
  end
end

fun permutation(n,k):
  factorial(n) / factorial(n - k)
end


fun combination(n,k):
  permutation(n,k) / factorial(k)
end

fun pascal-row(n):
  map(lam(x): combination(n, x) end, range(0, n + 1))
end

