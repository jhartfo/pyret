use context starter2024
include math

fun differences(seq):
  A = seq.drop(1)
  B = seq.take(length(seq) - 1)
  
  map2(lam(x,y): x - y end,  A,B)
end

fun factors(seq):
  A = seq.drop(1)
  B = seq.take(length(seq) - 1)
  
  map2(lam(x,y): x / y end,  A,B)
end
  
