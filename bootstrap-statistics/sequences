# build-linear :: List<Number> -> Function
fun build-linear(seq):
  a1 = seq.get(0)
  d = differences(seq).get(0)
  lam(x): (d * (x - 1)) + a1
  end
end

fun build-expt(seq):
  a1 = seq.get(0)
  r = factors(seq).get(0)
  lam(x): expt(r,(x - 1)) * a1
  end
end

