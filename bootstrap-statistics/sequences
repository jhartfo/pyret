fun make-differences(seq):
  fun pos-difference(x):
    seq.get(x + 1) - seq.get(x)
  end
  map(pos-difference, range(0,length(seq) - 1))
end

fun make-factors(seq):
  fun pos-factors(x):
    seq.get(x + 1) / seq.get(x)
  end
  map(pos-factors, range(0,length(seq) - 1))
end

