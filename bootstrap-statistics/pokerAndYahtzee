# These calculations can be found in a series of articles by 
# Courtney Taylor on https://www.thoughtco.com/

yahtzee-5K = 
  1/6 * 1/6 * 1/6 * 1/6 * 1/6 * 6 * permutation(5,0)

yahtzee-4K = 
  1/6 * 1/6 * 1/6 * 1/6 * 5/6 * 6 * permutation(5,1)

yahtzee-3K = (
  1 * 1 * 1 * 6       * # choose one of 6 faces 
  combination(5,2)    * # choose two different other faces
  permutation(5,2)      # our hand can be in any order 
  ) / num-expt(6,5)  

yahtzee-2K = (
  1 * 1 * 6           * # choose one of the faces
  combination(5,3)    * # choose three different other faces
  permutation(5,3)      # our hand can be in any order 
  ) / num-expt(6,5) 

yahtzee-FH = (
  combination(6,2)    * # choose to values for the FH
  2                   * # for each selection, there are two
                        # FHs: 33322 and 22233 
  combination(5,3)      # choose where the first three fall in the roll 
  ) / num-expt(6,5)     # (we could equivalently use C(5,2) )

yahtzee-LS = (
  2                   * # there are two difference long striaghts 
  factorial(5)          # our hand can be in any order 
  ) / num-expt(6,5)     

yahtzee-SS = ((
    # there are total of 14 possiblities:
    # 1,2,3,4 + not 5
    # 2,3,4,5 + not 1 or 6
    # 3,4,5,6 + not 2
    # 2 of these (1,2,3,4,6) and (1,3,4,5,6) have unique values
    2                 * # there are two difference long striaghts 
    factorial(5)        # our hand can be in any order 
    )               + ( # now we ADD the other 12 possibilities
    
    12                * # for the other 12, we
    combination(5,2)  * # choose where to place the two repeated dice
    factorial(3))       # and we can sort the remaining 3 dice
  ) / num-expt(6,5)     


