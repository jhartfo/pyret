###########################################

fun num-round-n(x,n):
  num-round(x * num-expt(10,n)) / num-expt(10,n)
end

###########################################

poker-5K = (
  combination(13,1)    * # choose a face value
  combination(4,5)     * # choose 5 out 4 of them
                         # This is will obviously be zero 
  factorial(5)           # our hand can be in any order       
  ) / falling-factorial(52,5)

poker-4K = (
  combination(13,1)    * # choose a face value
  combination(4,4)     * # choose 4 out of 4 of them
  combination(12,1)    * # choose a face value
  combination(4,1)     * # choose 1 out of 4 of them
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)

poker-3K = (
  combination(13,1)    * # choose a face value
  combination(4,3)     * # choose 3 out of 4 of them
  combination(12,2)    * # choose a face value
  combination(4,1)     * # choose 1 out of 4 of them
  combination(4,1)     * # choose 1 out of 4 of them 
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)

poker-FH = (
  combination(13,1)    * # choose a face value
  combination(4,3)     * # choose 3 out of 4 of them
  combination(12,1)    * # choose a face value
  combination(4,2)     * # choose 2 out of 4 of them
  factorial(5)           # our hand can be in any order d
  ) / falling-factorial(52,5)

poker-2K = (
  combination(13,1)    * # choose a face value
  combination(4,2)     * # choose 2 out of 4 of them
  combination(12,3)    * # choose a face value
  combination(4,1)     * # choose 1 out of 4 of them
  combination(4,1)     * # choose 1 out of 4 of them
  combination(4,1)     * # choose 1 out of 4 of them
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)

poker-2P = (
  combination(13,2)    * # choose a face value
  combination(4,2)     * # choose 2 out of 4 of them
  combination(4,2)     * # choose 2 out of 4 of them
  combination(11,1)    * # choose a face value
  combination(4,1)     * # choose 1 out of 4 of them
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)

poker-RF = (
  combination(4,1)     * # choose a suit
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)

poker-SF = ((
  combination(10,1)    * # 10 options of where to start the striaght
  combination(4,1)     * # choose a suit
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)) - 
poker-RF                 # don't count the Royal Flushes

poker-Fl = ((
  combination(4,1)     * # choose a suit
  combination(13,5)    * # choose any 5 cards from the suit
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)) - 
(poker-RF + poker-SF)    # don't count Royal and Straight Flushes 

poker-St = ((
  combination(10,1)    * # 10 options of where to start the striaght
  combination(4,1)     * # choose a suit for each card in the straight
  combination(4,1)     * # choose a suit for each card in the straight
  combination(4,1)     * # choose a suit for each card in the straight
  combination(4,1)     * # choose a suit for each card in the straight
  combination(4,1)     * # choose a suit for each card in the straight
  factorial(5)           # our hand can be in any order 
  ) / falling-factorial(52,5)) - 
(poker-RF + poker-SF)    # don't count Royal and Straight Flushes


