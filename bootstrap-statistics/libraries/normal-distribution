var DATA-CLR = "dodger-blue"
var BKGD-CLR = "white"
var WNDW-CLR = "light-goldenrod-yellow"
var TEXT-CLR = "black"
var NORM-CLR = "magenta"

# update state
fun update-SIZE(n)    : SIZE     := n end
fun update-DELTA(n)   : DELTA    := n end
