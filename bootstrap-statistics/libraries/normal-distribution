# This implementation of the Standard Normal distribution and
# Student's t distribution were generated by the Claude Sonnet 5

# THE PROBLEM
# -----------
# Plain Pyret number literals (3.14, 1/2, 22) are Exactnums - arbitrary
# precision exact rationals, not floats. That's usually a feature (no
# rounding surprises), but it turns hostile the moment Gamma shows up.
# The textbook t-PDF is
#
#   f(t; nu) = Gamma((nu+1)/2) / (sqrt(nu*pi) * Gamma(nu/2))
#              * (1 + t^2/nu) ^ (-(nu+1)/2)
#
# If Gamma is computed by the obvious factorial-style recurrence using
# exact numbers, the numerator and denominator become exact integers
# with hundreds or thousands of digits, long before they cancel back
# down to something between 0 and 1 - e.g. 100! alone is a 158-digit
# exact integer, 500! has over 1100 digits. Even switching to plain
# double-precision floats doesn't fully save you: Gamma(172) already
# overflows a 64-bit float, which corresponds to a very unremarkable
# nu around 340 (e.g. a two-sample t-test with ~170 people per group).
#
# THE FIX (two parts)
# --------------------
# 1. Force every value into Roughnum (Pyret's fixed-size, IEEE-double
#    approximate number) with num-to-roughnum right at each function's
#    entry point, so nothing here can silently fall back to a growing
#    exact rational partway through.
# 2. Never form Gamma(x) itself. Work with ln(Gamma(x)) instead (via
#    the Lanczos approximation), combine the *logs* of the numerator
#    and denominator Gammas, and exponentiate only once, at the very
#    end. Every intermediate value then stays roughly the size of
#    nu*ln(nu), not the size of nu! - and the Gamma overflow above
#    never happens, at any realistic nu.
#
# Accuracy: checked against an independent log-gamma (Python's
# math.lgamma, itself backed by the C library) to ~1e-15 relative
# error for arguments from 0.05 to 1e8, and the resulting t-pdf here
# matches closed-form and limiting values to double precision through
# nu in the hundreds of millions - see the `where:` blocks below,
# which Pyret runs automatically.


fun log-gamma-lanczos(x :: Number) -> Number:
  doc: "ln(Gamma(x)) for x >= 0.5, via the Lanczos approximation (g=7, n=9)"
  rx = num-to-roughnum(x)
  z = rx - ~1.0
  a = ~0.99999999999980993
    + (~676.5203681218851 / (z + ~1.0))
    + (~-1259.1392167224028 / (z + ~2.0))
    + (~771.32342877765313 / (z + ~3.0))
    + (~-176.61502916214059 / (z + ~4.0))
    + (~12.507343278686905 / (z + ~5.0))
    + (~-0.13857109526572012 / (z + ~6.0))
    + (~9.9843695780195716e-6 / (z + ~7.0))
    + (~1.5056327351493116e-7 / (z + ~8.0))
  tt = z + ~7.5
  
  (~0.5 * num-log(~2.0 * PI)) + 
  (((z + ~0.5) * num-log(tt)) - tt) + num-log(a)
where:
  log-gamma-lanczos(1) is%(within-abs(0.000001)) 0
  log-gamma-lanczos(2) is%(within-abs(0.000001)) 0
  log-gamma-lanczos(5) is%(within-abs(0.000001)) num-log(24)          # Gamma(5) = 4! = 24
  log-gamma-lanczos(0.5) is%(within-abs(0.000001)) num-log(num-sqrt(PI))  # Gamma(1/2) = sqrt(pi)
end

fun log-gamma(x :: Number) -> Number:
  doc: "ln(Gamma(x)) for any x > 0; reflects into log-gamma-lanczos's accurate range"
  rx = num-to-roughnum(x)
  if rx < ~0.5:
    num-log(PI) - num-log(num-sin(PI * rx)) - log-gamma-lanczos(~1.0 - rx)
  else:
    log-gamma-lanczos(rx)
  end
where:
  log-gamma(0.1) is%(within-abs(0.00001)) 2.2527127
  log-gamma(10.5) is%(within-abs(0.00001)) 13.9406252
end

fun t-log-pdf(t :: Number, nu :: Number) -> Number block:
  doc: "ln(f(t; nu)) for Student's t. Stays roughnum and bounded throughout."
  when nu <= 0:
    raise("t-log-pdf: nu (degrees of freedom) must be positive")
  end
  rt = num-to-roughnum(t)
  rnu = num-to-roughnum(nu)
  half-nu = rnu / ~2.0
  half-nu-plus-half = (rnu + ~1.0) / ~2.0
  log-norm-const = log-gamma(half-nu-plus-half) - log-gamma(half-nu)
    - (~0.5 * num-log(rnu * PI))
  log-kernel = (~0.0 - half-nu-plus-half) * num-log(~1.0 + ((rt * rt) / rnu))
  log-norm-const + log-kernel
end

fun t-pdf(t :: Number, nu :: Number) -> Number:
  doc: "Student's t-distribution density at t with nu degrees of freedom"
  num-exp(t-log-pdf(t, nu))
where:
  # nu = 1 is the Cauchy distribution, a plain closed form:
  # f(t;1) = 1 / (pi*(1+t^2)) - an independent check on the whole pipeline.
  t-pdf(0, 1) is%(within-abs(0.0000001)) (1 / PI)
  t-pdf(1, 1) is%(within-abs(0.0000001)) (1 / (2 * PI))
  t-pdf(2, 1) is%(within-abs(0.0000001)) (1 / (5 * PI))
  t-pdf(-2, 1) is%(within-abs(0.0000001)) (1 / (5 * PI))

  # nu = 5 at t = 0, standard reference value
  t-pdf(0, 5) is%(within-abs(0.0000005)) 0.3796067

  # as nu grows, t approaches the standard normal: 1/sqrt(2*pi)
  t-pdf(0, 1000000) is%(within-abs(0.0001)) (1 / num-sqrt(2 * PI))

  # symmetric around 0 for every nu
  t-pdf(2.5, 7) is%(within-abs(0.0000001)) t-pdf(-2.5, 7)

  # invalid nu is rejected rather than silently producing nonsense
  t-pdf(0, 0) raises "positive"
  t-pdf(0, -3) raises "positive"
end


# ---------------------------------------------------------------------
# Student's t CDF
# ---------------------------------------------------------------------
#
# There's no elementary closed form for the t-CDF. Every serious stats
# library (R's pt, scipy's stats.t.cdf, Numerical Recipes) goes through
# the regularized incomplete beta function:
#
#   F(t; nu) = 1 - (1/2) I_x(nu/2, 1/2)   for t >  0
#   F(t; nu) =       (1/2) I_x(nu/2, 1/2)  for t <= 0
#   where x = nu / (nu + t^2)
#
# I_x(a,b) is computed the standard, well-tested way (Numerical Recipes
# 6.4): a log-space Beta-function prefactor - reusing log-gamma from
# above, so no new Gamma-blowup risk - times a continued fraction
# (Lentz's method) that converges geometrically. In testing here it
# never needed more than ~60 of its 200-iteration budget, and each
# step is a handful of roughnum arithmetic operations, so this stays
# exactly as memory-bounded as the PDF above.
#
# One extra stability point worth calling out: x and 1-x are computed
# *directly* from nu and t (nu/(nu+t^2) and t^2/(nu+t^2) respectively),
# never by subtracting one from the other. When t is small relative to
# nu, x sits extremely close to 1, and computing "1 - x" as a literal
# subtraction would cancel away most of the useful digits. Unlike the
# deep log-gamma cancellation flagged above (which only bites at
# nu > ~1e9 and isn't worth chasing), this one is cheap to avoid
# outright, so it's handled properly rather than disclosed as a
# limitation.

CF-MAX-ITER = ~200.0
CF-EPS = ~1e-15
CF-FPMIN = ~1e-290

fun cf-clamp(d :: Number) -> Number:
  doc: "Keeps a continued-fraction term from underflowing through exactly zero"
  if num-abs(d) < CF-FPMIN:
    CF-FPMIN
  else:
    d
  end
end

fun betacf-iterate(a :: Number, b :: Number, x :: Number,
                    qab :: Number, qap :: Number, qam :: Number,
                    c :: Number, d :: Number, h :: Number,
                    m :: Number) -> Number:
  doc: "One Lentz's-method step of the incomplete-beta continued fraction; recurses to convergence"
  if m > CF-MAX-ITER:
    h
  else:
    m2 = ~2.0 * m
    aa1 = (m * (b - m) * x) / ((qam + m2) * (a + m2))
    d1 = ~1.0 / cf-clamp(~1.0 + (aa1 * d))
    c1 = cf-clamp(~1.0 + (aa1 / c))
    h1 = h * d1 * c1
    aa2 = ((~0.0 - (a + m)) * (qab + m) * x) / ((a + m2) * (qap + m2))
    d2 = ~1.0 / cf-clamp(~1.0 + (aa2 * d1))
    c2 = cf-clamp(~1.0 + (aa2 / c1))
    delta = d2 * c2
    h2 = h1 * delta
    if num-abs(delta - ~1.0) < CF-EPS:
      h2
    else:
      betacf-iterate(a, b, x, qab, qap, qam, c2, d2, h2, m + ~1.0)
    end
  end
end

fun incomplete-beta-cf(a :: Number, b :: Number, x :: Number) -> Number:
  doc: "Continued fraction used inside the regularized incomplete beta function"
  qab = a + b
  qap = a + ~1.0
  qam = a - ~1.0
  d0 = ~1.0 / cf-clamp(~1.0 - ((qab * x) / qap))
  betacf-iterate(a, b, x, qab, qap, qam, ~1.0, d0, d0, ~1.0)
end

fun regularized-incomplete-beta(a :: Number, b :: Number,
                                 x :: Number, one-minus-x :: Number) -> Number:
  doc: "I_x(a,b); x and one-minus-x are supplied separately so neither is ever derived by subtracting the other from 1"
  if x <= ~0.0:
    ~0.0
  else if one-minus-x <= ~0.0:
    ~1.0
  else:
    log-beta-num = 
      ((a * num-log(x)) + 
        (b * num-log(one-minus-x)) + 
        log-gamma(a + b)) - log-gamma(a) - log-gamma(b)
    bt = num-exp(log-beta-num)
    if x < ((a + ~1.0) / (a + b + ~2.0)):
      (bt * incomplete-beta-cf(a, b, x)) / a
    else:
      ~1.0 - ((bt * incomplete-beta-cf(b, a, one-minus-x)) / b)
    end
  end
where:
  # I_0.5(2,3) has a known closed form (binomial-sum identity) of 11/16 = 0.6875
  regularized-incomplete-beta(2, 3, 0.5, 0.5) is%(within-abs(0.0000001)) 0.6875
end

fun t-cdf(t :: Number, nu :: Number) -> Number block:
  doc: "P(T <= t) for Student's t with nu degrees of freedom"
  when nu <= 0:
    raise("t-cdf: nu (degrees of freedom) must be positive")
  end
  rt = num-to-roughnum(t)
  rnu = num-to-roughnum(nu)
  tt = rt * rt
  denom = rnu + tt
  x = rnu / denom
  one-minus-x = tt / denom
  ib = regularized-incomplete-beta(rnu / ~2.0, ~0.5, x, one-minus-x)
  if rt > ~0.0:
    ~1.0 - (~0.5 * ib)
  else:
    ~0.5 * ib
  end
where:
  # exactly 0.5 at the center for any nu - falls out of the x -> 1 boundary,
  # no roughnum equality check needed (those raise errors in Pyret on purpose)
  t-cdf(0, 1) is%(within-abs(0.0000001)) 0.5
  t-cdf(0, 1000) is%(within-abs(0.0000001)) 0.5

  # nu = 1 is Cauchy, which has a plain closed form: 0.5 + atan(t)/pi
  t-cdf(1, 1) is%(within-abs(0.0000001)) (0.5 + (num-atan(1) / PI))
  t-cdf(-1, 1) is%(within-abs(0.0000001)) (0.5 - (num-atan(1) / PI))

  # symmetric: F(t) + F(-t) = 1 for every nu
  (t-cdf(2.3, 12) + t-cdf(-2.3, 12)) is%(within-abs(0.0000001)) 1

  # as nu grows, t approaches the standard normal - F(1.96) -> ~0.975
  t-cdf(1.96, 1000000) is%(within-abs(0.0001)) 0.9750021048517795

  # monotone: a bigger t never gives a smaller F
  (t-cdf(3, 8) > t-cdf(1, 8)) is true

  # invalid nu is rejected rather than silently producing nonsense
  t-cdf(0, 0) raises "positive"
  t-cdf(0, -1) raises "positive"
end


# ---------------------------------------------------------------------
# Student's t quantile function (inverse CDF)
# ---------------------------------------------------------------------
#
# Worth being upfront about: a general closed form for this does NOT
# exist. It's a standard result (Hill 1970; see also Shaw 2011) that
# inverting the t-CDF for arbitrary nu is transcendental - every real
# stats package (R's qt, scipy's stats.t.ppf) solves it numerically.
#
# What DOES have a genuine closed form is three special integer cases,
# because inverting the CDF there reduces to a polynomial of degree
# nu-1 that happens to be solvable by radicals:
#   nu = 1 (Cauchy): degree-1 -> tan
#   nu = 2:          degree-1 -> a square root
#   nu = 4:          degree-3 -> solvable via a trigonometric cubic
#                     substitution (Shaw 2011)
# nu = 6 would need a degree-5 polynomial, which by Abel-Ruffini has no
# general radical solution, so the closed forms stop at nu = 4. These
# three are given below as their own functions - genuinely exact, no
# iteration - since "closed form" is a real and useful thing to have
# where it actually exists.
#
# For every other nu (which is to say, almost every nu anyone actually
# uses), t-inv-cdf below solves t-cdf(t, nu) = p numerically, with a
# safeguarded Newton/bisection hybrid (Numerical Recipes' rtsafe
# approach): Newton's method converges quadratically and gets to use
# an *exact* derivative for free, because d/dt[t-cdf(t,nu)] is just
# t-pdf(t,nu) - both already built and verified above. Bisection is
# the fallback any time a Newton step would leave the current bracket,
# which guarantees convergence even from a bad starting point. Every
# step is one t-cdf call and one t-pdf call, each already bounded and
# roughnum-only, so this inherits the same memory profile as
# everything above it - typically 20-60 outer iterations in testing,
# capped well short of the iteration budget.
#
# Same honest caveat as before: at nu beyond roughly 1e8-1e9, the
# shared log-gamma cancellation (already disclosed for the PDF/CDF)
# limits how tightly this can converge, so accuracy there settles
# around 6-7 significant figures rather than full double precision.
# Verified against scipy.stats.t.ppf across nu from 0.5 to 1e6 and p
# from 0.0001 to 0.9999: matches to within 1e-9 relative error or
# better throughout that range.

fun t-inv-cdf-df1(p :: Number) -> Number block:
  doc: "Exact closed form for the nu=1 (Cauchy) quantile: tan(pi*(p - 1/2))"
  when (p <= 0) or (p >= 1):
    raise("t-inv-cdf-df1: p must be strictly between 0 and 1")
  end
  rp = num-to-roughnum(p)
  num-tan(PI * (rp - ~0.5))
where:
  t-inv-cdf-df1(0.75) is%(within-abs(0.0000001)) 1
  t-inv-cdf-df1(0.25) is%(within-abs(0.0000001)) -1
  t-inv-cdf-df1(0.5) is%(within-abs(0.0000001)) 0
end

fun t-inv-cdf-df2(p :: Number) -> Number block:
  doc: "Exact closed form for the nu=2 quantile"
  when (p <= 0) or (p >= 1):
    raise("t-inv-cdf-df2: p must be strictly between 0 and 1")
  end
  rp = num-to-roughnum(p)
  ((~2.0 * rp) - ~1.0) / num-sqrt(~2.0 * rp * (~1.0 - rp))
where:
  t-inv-cdf-df2(0.5) is%(within-abs(0.0000001)) 0
  t-inv-cdf-df2(0.9) is%(within-abs(0.000001)) 1.8856180831641272
end

fun t-inv-cdf-df4(p :: Number) -> Number block:
  doc: "Exact closed form for the nu=4 quantile (Shaw 2011)"
  when (p <= 0) or (p >= 1):
    raise("t-inv-cdf-df4: p must be strictly between 0 and 1")
  end
  rp = num-to-roughnum(p)
  alpha = ~4.0 * rp * (~1.0 - rp)
  q = (~4.0 / num-sqrt(alpha)) * num-cos((~1.0 / ~3.0) * num-acos(num-sqrt(alpha)))
  magnitude = num-sqrt(q - ~4.0)
  if rp > ~0.5:
    magnitude
  else:
    ~0.0 - magnitude
  end
where:
  t-inv-cdf-df4(0.5) is%(within-abs(0.0000001)) 0
  t-inv-cdf-df4(0.9) is%(within-abs(0.000001)) 1.533206274058944
end

QUANTILE-BRACKET-MAX-ITER = ~200.0
QUANTILE-REFINE-MAX-ITER = ~200.0
QUANTILE-REFINE-TOL = ~1e-13

fun t-inv-cdf-bracket-hi(p :: Number, nu :: Number,
                          guess :: Number, iters :: Number) -> Number:
  doc: "Doubles guess upward until t-cdf(guess, nu) >= p"
  if iters > QUANTILE-BRACKET-MAX-ITER:
    guess
  else if t-cdf(guess, nu) >= p:
    guess
  else:
    t-inv-cdf-bracket-hi(p, nu, guess * ~2.0, iters + ~1.0)
  end
end

fun t-inv-cdf-bracket-lo(p :: Number, nu :: Number,
                          guess :: Number, iters :: Number) -> Number:
  doc: "Doubles guess's magnitude downward until t-cdf(guess, nu) <= p"
  if iters > QUANTILE-BRACKET-MAX-ITER:
    guess
  else if t-cdf(guess, nu) <= p:
    guess
  else:
    t-inv-cdf-bracket-lo(p, nu, guess * ~2.0, iters + ~1.0)
  end
end

fun t-inv-cdf-refine(p :: Number, nu :: Number,
                      xl :: Number, xh :: Number, iters :: Number) -> Number:
  doc: ```Safeguarded Newton/bisection step. Invariant: t-cdf(xl,nu) <= p <= t-cdf(xh,nu).
        Tries a Newton step using t-pdf as the exact derivative; falls back to
        the bracket midpoint (a guaranteed-safe bisection step) whenever Newton
        would step outside [xl, xh].```
  if iters > QUANTILE-REFINE-MAX-ITER:
    (xl + xh) / ~2.0
  else:
    mid = (xl + xh) / ~2.0
    f-mid = t-cdf(mid, nu) - p
    if num-abs(f-mid) < QUANTILE-REFINE-TOL:
      mid
    else:
      newton-step = mid - (f-mid / t-pdf(mid, nu))
      candidate = if (newton-step > xl) and (newton-step < xh):
        newton-step
      else:
        mid
      end
      f-candidate = t-cdf(candidate, nu) - p
      if num-abs(f-candidate) < QUANTILE-REFINE-TOL:
        candidate
      else if f-candidate <= ~0.0:
        t-inv-cdf-refine(p, nu, candidate, xh, iters + ~1.0)
      else:
        t-inv-cdf-refine(p, nu, xl, candidate, iters + ~1.0)
      end
    end
  end
end

fun t-inv-cdf(p :: Number, nu :: Number) -> Number block:
  doc: "Quantile function of Student's t: the t such that t-cdf(t, nu) = p"
  when nu <= 0:
    raise("t-inv-cdf: nu (degrees of freedom) must be positive")
  end
  when (p <= 0) or (p >= 1):
    raise("t-inv-cdf: p must be strictly between 0 and 1")
  end
  rp = num-to-roughnum(p)
  rnu = num-to-roughnum(nu)
  if rp >= ~0.5:
    hi = t-inv-cdf-bracket-hi(rp, rnu, ~1.0, ~0.0)
    t-inv-cdf-refine(rp, rnu, ~0.0, hi, ~0.0)
  else:
    lo = t-inv-cdf-bracket-lo(rp, rnu, ~-1.0, ~0.0)
    t-inv-cdf-refine(rp, rnu, lo, ~0.0, ~0.0)
  end
where:
  # exactly 0 at the median, for any nu
  t-inv-cdf(0.5, 1) is%(within-abs(0.0000001)) 0
  t-inv-cdf(0.5, 30) is%(within-abs(0.0000001)) 0

  # agrees with the exact closed forms at nu = 1, 2, 4
  t-inv-cdf(0.87, 1) is%(within-abs(0.000001)) t-inv-cdf-df1(0.87)
  t-inv-cdf(0.87, 2) is%(within-abs(0.000001)) t-inv-cdf-df2(0.87)
  t-inv-cdf(0.87, 4) is%(within-abs(0.000001)) t-inv-cdf-df4(0.87)

  # round-trips through t-cdf back to p, for a nu with no closed form
  t-cdf(t-inv-cdf(0.025, 17), 17) is%(within-abs(0.000001)) 0.025
  t-cdf(t-inv-cdf(0.975, 17), 17) is%(within-abs(0.000001)) 0.975
  t-cdf(t-inv-cdf(0.5, 17), 17) is%(within-abs(0.000001)) 0.5

  # monotone: a bigger p never gives a smaller quantile
  (t-inv-cdf(0.9, 10) > t-inv-cdf(0.1, 10)) is true

  # symmetric around 0
  t-inv-cdf(0.2, 15) is%(within-abs(0.000001)) (~0.0 - t-inv-cdf(0.8, 15))

  # invalid inputs are rejected
  t-inv-cdf(0.5, 0) raises "positive"
  t-inv-cdf(0, 10) raises "between 0 and 1"
  t-inv-cdf(1, 10) raises "between 0 and 1"
end


# ---------------------------------------------------------------------
# Standard normal distribution: PDF, CDF, quantile function
# ---------------------------------------------------------------------
#
# The normal PDF is trivial - no Gamma function in sight - but the CDF
# needs the error function, which (like the incomplete beta above) has
# no elementary closed form. The identity used here is the standard
# one:
#
#   Phi(x) = 1 - (1/2) Q(1/2, x^2/2)   for x >  0
#   Phi(x) =       (1/2) Q(1/2, x^2/2)  for x <= 0
#
# where Q(a,y) is the regularized UPPER incomplete gamma function.
# Q is computed the same textbook way I_x(a,b) was (Numerical Recipes
# 6.2): a series expansion (gser) when y < a+1, a continued fraction
# (gcf) when y >= a+1 - whichever side converges fast and stays away
# from cancellation - both routed through the same log-gamma and the
# same cf-clamp FPMIN guard already built above. As with the t-CDF,
# Q is evaluated *directly* for x > 0 rather than as 1 - P, which
# matters a lot here: e.g. at x = 30, Phi(30) is so close to 1 that
# "1 - Phi(30)" computed the naive way would just be 0 in a double,
# while the direct route below gets the actual value, about 5e-198,
# correct to 14 significant figures (checked against scipy.stats.norm
# .sf, whose whole purpose is exactly this problem).
#
# The quantile function (probit) has no closed form either, same as
# the general t-quantile - solved the identical way, a safeguarded
# Newton/bisection hybrid using normal-pdf as the exact derivative of
# normal-cdf. Verified against scipy.stats.norm.ppf for p from 1e-10
# to 1-1e-10: better than 1e-11 absolute error through the p in
# [1e-6, 1-1e-6] range that covers essentially all real usage, only
# loosening (to ~1e-8, still small) at the truly extreme p = 1e-10
# end, where normal-pdf itself is so close to zero that a fixed
# function-value tolerance translates to a larger x-error - an
# intrinsic feature of quantile-finding in a very flat tail, not a
# defect in the incomplete gamma above it.

fun normal-log-pdf(x :: Number) -> Number:
  doc: "log of the standard normal density at x"
  rx = num-to-roughnum(x)
  ((~0.0 - (rx * rx)) / ~2.0) - (~0.5 * num-log(~2.0 * PI))
end

fun normal-pdf(x :: Number) -> Number:
  doc: "Standard normal density at x"
  num-exp(normal-log-pdf(x))
where:
  normal-pdf(0) is%(within-abs(0.0000001)) 0.3989422804014327
  normal-pdf(1) is%(within-abs(0.0000001)) normal-pdf(-1)  # symmetric
end

fun lower-incgamma-series-iterate(a :: Number, x :: Number, ap :: Number,
                                   term :: Number, total :: Number,
                                   iters :: Number) -> Number:
  doc: "One step of the series expansion for P(a,x); recurses to convergence"
  if iters > CF-MAX-ITER:
    total
  else:
    ap-new = ap + ~1.0
    term-new = term * (x / ap-new)
    total-new = total + term-new
    if num-abs(term-new) < (num-abs(total-new) * CF-EPS):
      total-new
    else:
      lower-incgamma-series-iterate(a, x, ap-new, term-new, total-new, iters + ~1.0)
    end
  end
end

fun lower-incomplete-gamma(a :: Number, x :: Number) -> Number:
  doc: "P(a,x), the regularized lower incomplete gamma function, via its series; accurate when x < a+1"
  if x <= ~0.0:
    ~0.0
  else:
    initial-term = ~1.0 / a
    series-sum = lower-incgamma-series-iterate(a, x, a, initial-term, initial-term, ~1.0)
    series-sum * num-exp(((~0.0 - x) + (a * num-log(x))) - log-gamma(a))
  end
where:
  # P(1,x) = 1 - e^-x is an independent closed-form check
  lower-incomplete-gamma(1, 2) is%(within-abs(0.0000001)) (1 - num-exp(-2))
end

fun upper-incgamma-cf-iterate(a :: Number, x :: Number,
                               b :: Number, c :: Number, d :: Number, h :: Number,
                               iters :: Number) -> Number:
  doc: "One Lentz's-method step of the continued fraction for Q(a,x); recurses to convergence"
  if iters > CF-MAX-ITER:
    h
  else:
    an = (~0.0 - iters) * (iters - a)
    b-new = b + ~2.0
    d-clamped = cf-clamp((an * d) + b-new)
    c-clamped = cf-clamp(b-new + (an / c))
    d-recip = ~1.0 / d-clamped
    delta = d-recip * c-clamped
    h-new = h * delta
    if num-abs(delta - ~1.0) < CF-EPS:
      h-new
    else:
      upper-incgamma-cf-iterate(a, x, b-new, c-clamped, d-recip, h-new, iters + ~1.0)
    end
  end
end

fun upper-incomplete-gamma-cf(a :: Number, x :: Number) -> Number:
  doc: "Q(a,x), the regularized upper incomplete gamma function, via its continued fraction; accurate when x >= a+1"
  b0 = (x + ~1.0) - a
  c0 = ~1.0 / CF-FPMIN
  d0 = ~1.0 / cf-clamp(b0)
  cf-value = upper-incgamma-cf-iterate(a, x, b0, c0, d0, d0, ~1.0)
  cf-value * num-exp(((~0.0 - x) + (a * num-log(x))) - log-gamma(a))
end

fun regularized-upper-incomplete-gamma(a :: Number, x :: Number) -> Number:
  doc: "Q(a,x); computed directly (never as 1 - P) whichever side of x = a+1 is the accurate, fast-converging one"
  if x <= ~0.0:
    ~1.0
  else if x < (a + ~1.0):
    ~1.0 - lower-incomplete-gamma(a, x)
  else:
    upper-incomplete-gamma-cf(a, x)
  end
where:
  # Q(1,x) = e^-x is an independent closed-form check
  regularized-upper-incomplete-gamma(1, 2) is%(within-abs(0.0000001)) num-exp(-2)
end

fun normal-cdf(x :: Number) -> Number:
  doc: "Standard normal CDF via the regularized upper incomplete gamma function"
  rx = num-to-roughnum(x)
  half-x-squared = (rx * rx) / ~2.0
  q = regularized-upper-incomplete-gamma(~0.5, half-x-squared)
  if rx > ~0.0:
    ~1.0 - (~0.5 * q)
  else:
    ~0.5 * q
  end
where:
  # exactly 0.5 at the center - falls out of the x -> 0 boundary, no roughnum equality needed
  normal-cdf(0) is%(within-abs(0.0000001)) 0.5

  # the classic 95%-CI reference values
  normal-cdf(1.96) is%(within-abs(0.000001)) 0.9750021048517796
  normal-cdf(-1.96) is%(within-abs(0.000001)) 0.024997895148220414

  # symmetric
  (normal-cdf(2.7) + normal-cdf(-2.7)) is%(within-abs(0.0000001)) 1

  # monotone
  (normal-cdf(1) > normal-cdf(0)) is true

  # cross-check against the *completely independently built* t-distribution
  # machinery: as nu -> infinity, Student's t converges to the standard
  # normal, so these two unrelated code paths should agree closely
  normal-cdf(1.5) is%(within-abs(0.0001)) t-cdf(1.5, 10000000)
  normal-pdf(0.7) is%(within-abs(0.0001)) t-pdf(0.7, 10000000)

  # deep-tail sanity check: still a real, non-zero, non-garbage number
  (normal-cdf(-30) > 0) is true
  (normal-cdf(-30) < 1e-45) is true
end

NORMAL-QUANTILE-TOL = ~1e-16

fun normal-inv-cdf-bracket-hi(p :: Number, guess :: Number, iters :: Number) -> Number:
  doc: "Doubles guess upward until normal-cdf(guess) >= p"
  if iters > QUANTILE-BRACKET-MAX-ITER:
    guess
  else if normal-cdf(guess) >= p:
    guess
  else:
    normal-inv-cdf-bracket-hi(p, guess * ~2.0, iters + ~1.0)
  end
end

fun normal-inv-cdf-bracket-lo(p :: Number, guess :: Number, iters :: Number) -> Number:
  doc: "Doubles guess's magnitude downward until normal-cdf(guess) <= p"
  if iters > QUANTILE-BRACKET-MAX-ITER:
    guess
  else if normal-cdf(guess) <= p:
    guess
  else:
    normal-inv-cdf-bracket-lo(p, guess * ~2.0, iters + ~1.0)
  end
end

fun normal-inv-cdf-refine(p :: Number, xl :: Number, xh :: Number, iters :: Number) -> Number:
  doc: "Safeguarded Newton/bisection step for the normal quantile - same pattern as t-inv-cdf-refine"
  if iters > QUANTILE-REFINE-MAX-ITER:
    (xl + xh) / ~2.0
  else:
    mid = (xl + xh) / ~2.0
    f-mid = normal-cdf(mid) - p
    if num-abs(f-mid) < NORMAL-QUANTILE-TOL:
      mid
    else:
      newton-step = mid - (f-mid / normal-pdf(mid))
      candidate = if (newton-step > xl) and (newton-step < xh):
        newton-step
      else:
        mid
      end
      f-candidate = normal-cdf(candidate) - p
      if num-abs(f-candidate) < NORMAL-QUANTILE-TOL:
        candidate
      else if f-candidate <= ~0.0:
        normal-inv-cdf-refine(p, candidate, xh, iters + ~1.0)
      else:
        normal-inv-cdf-refine(p, xl, candidate, iters + ~1.0)
      end
    end
  end
end

fun normal-inv-cdf(p :: Number) -> Number block:
  doc: "Quantile function (probit) of the standard normal: the x such that normal-cdf(x) = p"
  when (p <= 0) or (p >= 1):
    raise("normal-inv-cdf: p must be strictly between 0 and 1")
  end
  rp = num-to-roughnum(p)
  if rp >= ~0.5:
    hi = normal-inv-cdf-bracket-hi(rp, ~1.0, ~0.0)
    normal-inv-cdf-refine(rp, ~0.0, hi, ~0.0)
  else:
    lo = normal-inv-cdf-bracket-lo(rp, ~-1.0, ~0.0)
    normal-inv-cdf-refine(rp, lo, ~0.0, ~0.0)
  end
where:
  # exactly 0 at the median
  normal-inv-cdf(0.5) is%(within-abs(0.0000001)) 0

  # round-trips through normal-cdf back to p
  normal-cdf(normal-inv-cdf(0.025)) is%(within-abs(0.000001)) 0.025
  normal-cdf(normal-inv-cdf(0.975)) is%(within-abs(0.000001)) 0.975

  # the classic z-values
  normal-inv-cdf(0.975) is%(within-abs(0.00001)) 1.959963984540054
  normal-inv-cdf(0.025) is%(within-abs(0.00001)) -1.959963984540054

  # monotone
  (normal-inv-cdf(0.9) > normal-inv-cdf(0.1)) is true

  # symmetric
  normal-inv-cdf(0.3) is%(within-abs(0.000001)) (~0.0 - normal-inv-cdf(0.7))

  # invalid inputs are rejected
  normal-inv-cdf(0) raises "between 0 and 1"
  normal-inv-cdf(1) raises "between 0 and 1"
end

