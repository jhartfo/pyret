fun S1(n,k): # stirling number of the first kind
  if n == k: 1
  else if (n == 0) or (k == 0): 0
  else: S1(n - 1, k - 1) + ((n - 1) * S1(n - 1, k))
  end
end

fun S2(n,k): # stirling number of the second kind
  if n == k: 1
  else if (n == 0) or (k == 0): 0
  else: S2(n - 1, k - 1) + (k * S2(n - 1, k))
  end
end

fun S1s(n,k): # signed stirling number of the first kind
  value = 
    if n == k: 1
    else if (n == 0) or (k == 0): 0
    else: S1(n - 1, k - 1) + ((n - 1) * S1(n - 1, k))
  end
  value * num-expt(-1, n - k)
end

fun factorial(n):
  if n == 0: 1
  else if n == 1: 1
  else: n * factorial(n - 1)
  end
end

fun S2M(n):
  build-matrix(n, n, lam(i,j): S2(i,j) end).transpose()
end

fun S1M(n):
  build-matrix(n, n, lam(i,j): S1s(i,j) end).transpose()
end

fun D(n):
  build-matrix(n, n, lam(i,j): if i == j: factorial(i) else: 0 end end).transpose()
end

fun d(n):
  D(n).inverse()
end

fun coeffs(delta):
  n = length(delta.row-list())
  mtx-to-list(S1M(n) * d(n) * delta)
end

fun monomial(c,power):
  lam(x): num-expt(x,power) * c
  end
end

fun evaluate(fn, x): fn(x) end

fun polynomial(c):
  powers = reverse(range(0, length(c)))
  terms = map2(monomial, c, powers)
  lam(x): sum(map(lam(fn): evaluate(fn,x) end, terms))
  end
end 

