# strictly linear regression (that is the regression curve is a
# line, plane, or hyper-plane
fun multiple-LR-coeffs(explainers, response):
  P      = explainers.length() + 1
  N      = response.length()
  beta-0 = repeat(N, 1)
  Y      = list-to-col-matrix(response)
  X      = lists-to-matrix([list: beta-0] + explainers).transpose()
  beta   = (X.transpose() * X).inverse() * X.transpose() * Y
  mtx-to-list(beta)
end

# the function that is generated has a single List parameter 
fun multiple-LR(explainers,response):
  coeffs    = multiple-LR-coeffs(explainers, response)
  intercept = coeffs.get(0)
  non-const = coeffs.drop(1)
  lam(X): sum(map2(_ * _, X, non-const)) + intercept end
end

LR-coeffs = multiple-LR-coeffs([list: width, height], perimeter)
y-hat     = multiple-LR([list: width, height], perimeter)


