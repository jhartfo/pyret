mean        = lam(X): sum(X) / X.length() end
std-dev     = lam(X): 
  num-sqrt(sum(map(
        lam(y): 
          num-sqr(y - mean(X))
        end, 
        X)) / (X.length() - 1)) 
end

z-score      = lam(x,m,s): (x - m) / s end
z-scores     = lam(X): map(lam(x): z-score(x,mean(X), std-dev(X)) end, X) end

