# ADVANCED MOVES
# these can look at many of the possibilities 
# referenced in lines 122 and 123 at once:



bkgd = square(400, "outline", "white")

fun t3(s):
  gts = lam(x):
    # we reversed the flow of rotate and the color in this version
    rotate(s * (255 - x), triangle(x, "solid", my-green(255 - x)))
  end
  ts = map(gts, range(0,255))
  foldl(overlay, bkgd, ts)
end

