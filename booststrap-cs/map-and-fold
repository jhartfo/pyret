# While in a H.S. Algebra class our Functions 
# are typically restricted to functions like:
# (f :: Number -> Number) or      
# (f :: Number, Number -> Number) like with plus.
#
# but we can be more creative. For example, 
# we can map a List of Numbers to Images! 
fun gt(x): triangle(x,"solid", "green") end

# this next line gives us thousand triangles in one line!
triangles-1 = map(gt, range(0,1000))

# If we wanted to combine Images, we wouldn't use
# plus, we could instead use overlay or any other 
# Function that combines Images.
image-1 = fold(overlay, empty-image, triangles-1)

# Thats a bit boring, since all the triangles are
# the same color. Pyret has the ability to define
# custom colors using the color Function from the 
# color library. 

# color :: Number, Number, Number, Number -> Color
# The first 3 numbers are on a scale of 0-255
# and provide the RGB level of red, green, and blue
# respectively. The fourth Number is on a scale of 0-1 
# provides the level of transparency of the color.
# my-color is "black"
my-color = color(0,0,0,1)

# With this in hand, we can define a Function that 
# takes in a Number that will create our create 
# a color for us!
# my-green :: Number -> Color
fun my-green(x): color(0,x,0,1) end

# check out my-triangle
my-triangle = triangle(50, "solid", my-green(127))

# Now we can create a new green triangle function 
# that changes the size AND the color!
fun gt-2(x): triangle(x, "solid", my-green(x)) end

# let's make a list of triangles and combine them
triangles-2 = map(gt-2, range(0,255))
image-2 = fold(overlay, empty-image, triangles-2)

# we can be even more dynamic:
# gt-3 uses the Number three ways, it tells us the size 
# of triangle, its color and then the Number of 
# degrees the triangle is rotated 
# (the x is scaled by some factor)
scale-factor = 1
fun gt-3(x): 
  rotate(scale-factor * x,triangle(x, "solid", my-green(x))) 
end
triangles-3 = map(gt-3, range(0,255))
image-3 = fold(overlay, empty-image, triangles-3)

# try changing the value of scale-factor, 
# see how that effects image-3!

