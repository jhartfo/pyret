# OR we could make a reactor!

fun tick-1(x): x + 0.5  end
fun tick-2(x): x + 2/100 end
fun stop-1(x): x >= 360/4 end
fun stop-2(x): x >= 1 end

design-1 = reactor:
  init: 1,
  on-tick: tick-1,
  #stop-when: stop-1,
  to-draw: t3
end

design-2 = reactor:
  init: 0/100,
  on-tick: tick-2,
  #stop-when: stop-2,
  to-draw: t3
end

# these lines will each animate list-1 and list-2
interact(design-1)
interact(design-2)









