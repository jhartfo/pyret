# write a function called deviations that will transform the list 
# by taking away the mean from each element of the list

# deviations :: List -> List
# Consumes a list, calculates the mean and transforms the list by
# subtracting the mean from each element
examples:
  deviations(list-1) is map(_ - list-mean(list-1), list-1)
  deviations(list-2) is map(_ - list-mean(list-2), list-2)
end
fun deviations(some-list):
  map(_ - list-mean(some-list), some-list)
end
  
