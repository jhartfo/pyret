use context starter2024

include math 

fun mu(x,y,n):
  (x * y) / n
end

fun error(x,y):
  num-sqr(x - y) / y
end


fun g(x,y):
  x * num-log(x / y)
end

fun df(x,y): (x - 1) * (y - 1) end

fun std-res(x,y,a,b,n):
  (x - y) / num-sqrt(y * (1 - (a / n)) * (1 - (b / n)))
end

