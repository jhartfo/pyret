use context essentials2021

include color

l00     = 'NEW COLOSSUS'
l01     = 'Not like the brazen giant of Greek fame,'
l02     = 'With conquering limbs astride from land to land;'
l03     = 'Here at our sea-washed, sunset gates shall stand'
l04     = 'A mighty woman with a torch, whose flame'
l05     = 'Is the imprisoned lightning, and her name'
l06     = 'Mother of Exiles. From her beacon-hand'
l07     = 'Glows world-wide welcome; her mild eyes command'
l08     = 'The air-bridged harbor that twin cities frame.'
l09     = ''
l10     = '"Keep, ancient lands, your storied pomp!" cries she'
l11     = 'With silent lips. "Give me your tired, your poor,'
l12     = 'Your huddled masses yearning to breathe free,'
l13     = 'The wretched refuse of your teeming shore.'
l14     = 'Send these, the homeless, tempest-tost to me,'
l15     = 'I lift my lamp beside the golden door!"'
l16     = '~Emma Lazarus'

colossus= image-url(
      "https://code.pyret.org/shared-image-contents?sharedImageId=1Q_rqKG2ahYscbNBJYNIGHgoK-RmjrDhY")

WT      = 800
HT      = 600
CLR     = color(220,255,220,1)
SIZE    = HT / 30

LIBERTY = scale((1 / image-height(colossus)) * HT * 0.9,colossus)

WHITE1     = "white"
WHITE2     = color(250,250,150,0.50)
WHITE3     = color(250,250,150,0.30)
BLUE1      = color(180,180,255,0.90)
BLUE2      = color(000,000,255,0.50)
RED1       = color(255,180,100,0.90)
RED2       = color(255,030,000,0.50)
RED3       = "crimson"

NUM-WHTE   = 20
NUM-BLUE   = 10
NUM-RED    = 10
NUM-LRG    = 3
TOTAL      = NUM-WHTE + NUM-BLUE + NUM-RED + NUM-LRG

lines      = [list: l00,
  l01,l02,l03,l04,l05,
  l06,l07,l08,l09,l10,
  l11,l12,l13,l14,l15,
  l16]

fun line-list(size,clr):   
  map(lam(x): text(x,size,clr) end, lines) 
end

fun poem(align, lst): 
  image = fold(
    lam(x,y):above-align(align,x,y) end, 
    empty-image, lst
    )
  h = image-width(image) / 2
  k = image-height(image) / 2 
  place-pinhole(h,k,image)
end
  
fun random-a-b(a,b) : num-random(b - a) + a end

fun random-size(x): 0.25 * random-a-b(1,3) end

fun random-x1(x)  : random-a-b(0.00 * WT, 1.00 * WT) end
fun random-y1(x)  : random-a-b(0.00 * HT, 1.00 * HT) end
fun random-y2(x)  : random-a-b(0.50 * HT, 1.00 * HT) end
fun random-y3(x)  : random-a-b(0.75 * HT, 1.00 * HT) end

rect = rectangle(WT,HT,"solid","black")

fun sim-star(s,clr1, clr2):
  scale(s, 
    overlay(
      circle(2,"solid",clr1),
      circle(4,"solid",clr2))
    )
end

fun w-star(s): sim-star(s, WHITE1, WHITE2) end
fun b-star(s): sim-star(s, BLUE1,  BLUE2)  end
fun r-star(s): sim-star(s, RED1,   RED2)   end

fun L-star(s): 
  rotate(1,
  scale(s, overlay(
        w-star(s / 1.1),
        rhombus(60, 4, "solid",WHITE3)
        )))
end

stars = fold(
  append,
  empty,
  [list:
    map(w-star,map(random-size,range(0,NUM-WHTE))),
    map(b-star,map(random-size,range(0,NUM-BLUE))),
    map(r-star,map(random-size,range(0,NUM-RED ))),
    map(L-star,map(random-size,range(0,NUM-LRG )))]
  )

star-Xs = map(random-x1, range(0,TOTAL))

star-Ys = fold(
  append,
  empty,
  [list:
    map(random-y1,range(0,NUM-WHTE)),
    map(random-y2,range(0,NUM-BLUE)),
    map(random-y3,range(0,NUM-RED )),
    map(random-y3,range(0,NUM-LRG ))]
  )

fun reverse-put-image(bs, x, y, im): put-image(im, x, y, bs) end

sky = put-image(
  LIBERTY, WT * 0.75, HT * 0.45,
  fold3(reverse-put-image, rect, star-Xs, star-Ys, stars)
  )

put-image(
  poem("center",line-list(SIZE,CLR)),
  WT * 0.35, HT / 2,
  sky)



