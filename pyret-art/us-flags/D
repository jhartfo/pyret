# flatten :: List -> List
# consumes a list of lists and produces a single list
# whose elements are the elements of the sublists
fun flatten(lst):
  fold(append, empty, lst)
end

#alternate :: List, Number  -> List
fun alternate(elements, n):
  len       = length(elements)
  remainder = num-modulo(n,len)
  base      = repeat(num-floor(n / len), elements)
  
  flatten(base.append([list:elements.take(remainder)]))
end
  
r-w = alternate([list:RED-STRIPE, WHITE-STRIPE], 13)
b-w = alternate([list: star-6, star-5], 9)

rw  = fold(below, empty-image, r-w)
bw  = fold(below, empty-image, b-w)

b   = overlay-align("center","center", bw, BLUE-RECT)

overlay-align("left", "top", b,rw)

