BLUE         = color(0,33,71,1)

####################################################
# Let's define some functions

stack-lists :: List -> List
# stack-lists consumes a List containing other lists and
# returns a new List whose elements come from the elements
# of the component Lists which are appended to the elements 
# of the previous component List. (did you follow that?)
# (it just smashes Lists together.)
examples:
  stack-lists([list: [list:1],[list: 2],[list: 3]]) is [list: 1,2,3]
  stack-lists([list: [list: ],[list:  ],[list:  ]]) is [list: ]
end
fun stack-lists(lists):
  fold(lam(x,y): append(x,y) end, [list:], lists)
end

# test images and elements for the below examples:
rd           = circle(10, "solid", "red")
wh           = circle(10, "solid", "white")
bl           = circle(10, "solid", "blue")
br           = rectangle(UNON-WT, UNON-HT, "solid",BLUE)
em           = empty-image

arrange-images :: Image, List, List, List -> Image
# arrange-images consumes a base Image, a List of x-coords, a List of y-coords, and a List of Images and will return a new image
# where the elements of the List of images is placed on the base 
# Image at locations from the list of coordinates.
examples:
  arrange-images(
    br,[list:0,10,20,30],[list:0,10,20,30], [list: rd,wh,rd,wh]) is 
  fold3(lam(b,x,y,i): put-image(i,x,y,b) end, br, [list:0,10,20,30],[list:0,10,20,30] , [list: rd,wh,rd,wh])
end
fun arrange-images(base, xs,ys, image-lists):
  fold3(lam(b,x,y,i): put-image(i,x,y,b) end, base, xs,ys, image-lists)
end

####################################################
# List of coordinates

Y-list       = map(SPACE-Y * _ , stack-lists([list:
      repeat(ODD-COUNT,1), repeat(EVEN-COUNT,2), 
      repeat(ODD-COUNT,3), repeat(EVEN-COUNT,4), 
      repeat(ODD-COUNT,5), repeat(EVEN-COUNT,6),
      repeat(ODD-COUNT,7), repeat(EVEN-COUNT,8), 
      repeat(ODD-COUNT,9)]))

X-list-odd   = map(lam(x): ((2 * x) - 1) * SPACE-X end, 
  range(1,ODD-COUNT + 1))

X-list-even  = map(lam(x): (2 * SPACE-X) * x end, 
  range(1,EVEN-COUNT + 1))

X-list       = stack-lists(
  repeat(4,X-list-odd.append(X-list-even)))
  .append(X-list-odd)

