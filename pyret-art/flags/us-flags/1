WHITE-STRIPE = rectangle(STRP-WT, STRP-HT, "solid", color(255,255,250,1))
WHITE-STAR   = star(STAR-DI, "solid", color(255,255,250,1))
BLUE-STAR    = overlay( WHITE-STAR, rectangle(SPACE-X, SPACE-Y, "solid", color(0,33,71,1)))

