############################################
# Hangman Data type
#
# This data type manages all things
# hangman. A Hangman has 7 properties. 
# First is a Number, this Number, 0-6,
# tells us how far along we have advanced in
# the game. Zero is the start of the game; 
# six is game over (there maybe ways to manage
# this without status by monitoring the other 
# six properties...) The other 6 properties store 
# Color Strings ("transparent" or "black"). This tells us 
# what color to paint the cooresponding hangman 
# parts. 
#
# A Hangman has 2 methods: .display() draws
# the hangman using the above functions. 
# .advance() will create a new Hangman 
# with an additional "black" body part compared
# to the current one.

data Hangman:
  | hangman(
      status :: Number,
      head   :: String,
      body   :: String,
      l-arm  :: String,
      l-leg  :: String,
      r-arm  :: String,
      r-leg  :: String) with:
    method display(self):
      man(self) 
    end,
    
    # This method make use of the functions below
    # to make defining new Hangmans easier.
    # the ask block simplifies repeated if-else-if
    # blocks. In this case if the status is n
    # we produce a Hangman of status n+1
    method advance(self):
      ask :
        | self.status == 0 then: build-hangman(1)
        | self.status == 1 then: build-hangman(2)
        | self.status == 2 then: build-hangman(3)
        | self.status == 3 then: build-hangman(4)
        | self.status == 4 then: build-hangman(5)
        | self.status == 5 then: build-hangman(6)
        | otherwise: self
      end
    end
end

list-to-hangman :: List -> Hangman
# this Function streamlines the Hangman
# intializing process. Instead of 
# manually entering the individual fields 
# a the Hangman, we are just put into a 
# List, and list-to-hangman places
# elements in the appropriate field.
fun list-to-hangman(lst):
  if length(lst) == 7:
    hangman(
      lst.get(0), lst.get(1), lst.get(2), lst.get(3), 
      lst.get(4), lst.get(5), lst.get(6))
  else:
    # error handling
    raise("Hangman has 7 properties")
  end
end

build-hangman :: Number -> Hangman
# this Function also streamlines the 
# Hangman initializing process. Here, we
# consume a Number, n, and produce a 
# Hangman with n "black" body parts.
fun build-hangman(n):
  list-to-hangman(
    [list: n] + repeat(n, "black") + repeat(6 - n, "transparent"))
end

# Now, we can quickly define the different 
# possible Hangmans.
HANGMAN-0 = build-hangman(0)
HANGMAN-1 = build-hangman(1)
HANGMAN-2 = build-hangman(2)
