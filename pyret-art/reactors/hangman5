############################################
# Letter data type 

# Throughout the game, we need more than 
# just information about Strings that make up 
# a word, we need to also know whether the
# String has been used.
#
# the Letter datatype has to properties the 
# character (a String) and used (a Boolean)
# 
# additionally, it has two similar methods
# .display-secret() and .display-all()
# The first is used to display letters 
# in the secret word (as an Image). The other is for 
# displaying the list of available letters 
# (as an Image). There are many
# different ways to implement the methods. I think
# this is the most straightforward. For clarity,
# how the methods work is defined below as separate 
# Functions.
# 
# Finally, there is a third method for using
# a Letter called .use-one-letter()
data Letter:
  | letter(char :: String, used :: Boolean) with:
    
    method display-secret(self): 
      if self.used:
        view-secret-letter(self.char, "black")
      else:
        view-secret-letter(self.char, "white")
      end
    end,
    
    method display-used(self): 
      if self.used:
        view-used-letter(self.char, "black") 
      else:
        view-used-letter(self.char, "white") 
      end
    end,
    
    method use-one-letter(self, A):
      use-one-letter(self, A)
    end
end

view-secret-letter :: String, String -> Image
view-used-letter   :: String, String -> Image
# The two functions consume a String containing one
# letter and a Color String and builds a box containing
# the letter. If the letter should be visible then
# the background with "white" otherwise the background 
# is "black." view-secret-letter adds a line at the bottom ro
# serve as a blank to help the player see how many letters
# are in the secret-word. Both Images have a transparent 
# rectangle tacked on beside the box to space out the letters
fun view-secret-letter(ltr, clr):
  beside(
    overlay-align("center", "center",
      text(ltr, 28, clr),
      overlay-align("center", "bottom",
        rectangle(30, 2, "solid", "black"),
        rectangle(33,30, "solid", "white"))),
    rectangle(2, 30, "solid", "transparent")
    )
end

fun view-used-letter(ltr, clr):
  beside(
    overlay-align("center", "center",
      text(ltr, 15, "black"),
      rectangle(20,20, "solid", clr)
      ),
    rectangle(3, 20, "solid", "transparent")
    )
end

use-one-letter :: Letter, String -> Letter
# consumes a Letter and a String. If the 
# Letter's char matches the String, we produce
# a new Letter with .used updated to true
# otherwise we return the original Letter
fun use-one-letter(ltr,A):
  if ltr.char == A:
    letter(ltr.char, true)
  else:
    ltr
  end
end

string-to-letter :: String -> Letter
# creates a Letter from the String
# defaults to not used
fun string-to-letter(s):
  letter(s, false)
end

string-to-used :: String -> Letter
# creates a Letter from the String
# defaults to used
fun string-to-used(s):
  letter(s, true)
end


############################################
# Letter-List datatype
#
# This datatype only has one property: THE LIST
# we create it so we can create some methods
# to help us manage the game cleanly without getting 
# lost in the details. Like with Letter, there maybe 
# other ways to implement this. 
#
# This kind of object is called a 'wrapper'
# because we are takling something already known
# (in this case a List), and wrapping it, in whole,
# into a new object, merely to create new custom 
# properties and methods.
#
# Here we have 3 methods: .display-secret() and 
# .display-used() will use fold to stack together 
# the displayed Letter-s. For display-used(), we 
# break the Letters up into two rows.
#
# Finally, we have .update-letter-list()
# that references the Letter method 
# use-one-letter to update the Letters in 
# the Letter-List accordingly
data Letter-List:
  | letters(chars:: List) with:
    
    method display-secret(self): 
      view-secret-list(self.chars)
    end,
    method display-used(self): 
      view-used-list(self.chars)
    end,
    method update-letter-list(self, A): 
      # contract of update-list is
      # update-list:: List -> List
      # so, we need to recast the list as a
      # Letter-List. (I suppose we could create 
      # a custom map Function that plays nicely 
      # with Letter-Lists directly.)
      letters(update-list(self.chars,A)) 
    end
end

view-secret-list :: List -> Image
# using beside we fold all of the displayed 
# Letter into a single Image
fun view-secret-list(lst):
  fold(beside, empty-image,map(_.display-secret(), lst))
end

view-used-list :: List -> Image
# similar to view-secret-list except
# row-1 takes the first 13 elements 
# in the list, row-2 drops the first 13 
# elements. Then we use above to stack
# together the rows
fun view-used-list(lst):
  row-1 = fold(beside, empty-image,
    map(_.display-used(), lst.take(13)))
  
  row-2 = fold(beside, empty-image,
    map(_.display-used(), lst.drop(13)))
 
  above(
    above(
      row-1, 
      rectangle(20, 3, "solid", "transparent")), 
    row-2)
end
  
update-list :: List, String -> List
# Consumes the chars (a List) from a Letter-List
# and uses to map and use-one-letter to 
# create a new List of Letters.
fun update-list(lst,A):
  (map(use-one-letter(_,A), lst))
end

list-to-letter-list :: List -> Letter-List
# consumes a list of Strings and produces
# Letter-List containing not .used Letters 
fun list-to-letter-list(lst):
  letters(map(string-to-letter, lst))
end

list-to-used-list :: List -> Letter-List
# consumes a list of Strings and produces
# Letter-List containing .used Letters
fun list-to-used-list(lst):
  letters(map(string-to-used, lst))
end

# Let's define some constants involving 
# Letter-Lists
#ALPHABET     = "abcdefghijklmnopqrstuvwxyz"
ALPHABET     = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
ABC-exploded = string-explode(ALPHABET)
ABC-LIST     = list-to-letter-list(ABC-exploded)
ABC-USED     = list-to-used-list(ABC-exploded)


############################################
# Game-Data datatype
# We are almost ready to start assembling 
# our game. Here we have the data type 
# that will store all the data we need 
# throughout the game. We need a Hangman, called 'HM',
# the orginal word called 'word-raw', the 'word' 
# is a Letter-List of the secret word's characters,
# and 'letters' is the Letter-List of the 
# alphabet
data Game-Data:
    game-data(
      HM       :: Hangman    ,
      word-raw :: String     ,
      word     :: Letter-List,
      letters  :: Letter-List,
      guess    :: String 
      # I decided to add guess back for the fancy 
      # stuff at the very bottom.
      )
end


############################################
# Game Operation Functions

get-background :: Game-Data -> String
# determines the background color by 
# looking at the current state of the game. 
# If the game.HM is 6, the color is KO-CLR
# If the all the Letters in the word are used
# the color is WN-CLR. Otherwise we use BG-CLR
fun get-background(state):
  if state.HM.status == 6: KO-CLR
  else if all(_ == true, map(_.used, state.word.chars)): WN-CLR
  else: BG-CLR
  end
end

draw-game :: Game-Data -> Image
# the main draw Function. We combine the 
# HM.display(), the gallows, 
# word.display-secret(), and 
# letters. display-used()
fun draw-game(state):
  put-image(
    state.HM.display(), 100, 99, 
    put-image(
      state.word.display-secret(), 372, 150, 
      put-image(
        state.letters.display-used(), 400, 50, 
        gallows(
          get-background(state))
        )))
end

guess :: Game-Data, String -> Game-Data
fun guess(state, key):
  
  # while we want to display uppercase letters,
  # but our key presses will be lowercase. So, 
  # create k to be the uppercase of the key pressed.
  k = string-to-upper(key)
  
  # if k is a member of the ALPHABET,
  if string-contains(ALPHABET, k):
    # we check if k is a member of the word
    # if so, we update appropriately
    if string-contains(state.word-raw,key):
      game-data(
        state.HM,
        state.word-raw,
        state.word.update-letter-list(k),
        state.letters.update-letter-list(k),
        key
        )
    
    # if not, we update appropriately
    else:
      game-data(
        state.HM.advance(),
        state.word-raw,
        state.word,
        state.letters.update-letter-list(k),
        key
        )
    end
    
  # If k is not a memeber of the ALPHABET,
  # noting happens (we return the current
  # state)
  else:
    state
  end
end

on-tick :: Game-Data -> Game-Data
# This Function checks every tick
# to see if we have reached HM.status 
# level 6. If so, we switch everythng off
# The Letter-List update-list() method 
# cannot undo the used status, so the
# unveiling cannot be undone.
fun on-tick(state):
  
  if state.HM.status == 6:
    game-data(
      state.HM,
      state.word-raw,
      list-to-used-list(
        string-explode(
          string-to-upper(state.word-raw))),
      ABC-USED,
      ""
      )
  else:
    state
  end
end

idx           = num-random(table.length())
