# We will need several different data types

# there is a predefined data type called Hangman

data Letter:
  |word-letter(char :: String, visible :: Boolean) with:
    method display(self): 
      if self.visible:
        view-word-letter(self.char, "black")
      else:
        view-word-letter(self.char, "white")
      end
    end,
        
  |letter(char :: String, used :: Boolean) with:
    method display(self): 
      if self.used:
        view-used-letter(self.char, "black") 
      else:
        view-used-letter(self.char, "white") 
      end
    end
end

fun update-word(lst, A):
  if length(lst) <= 1: 
    if lst.first.char == A:
      link(word-letter(lst.first.char, true), empty)
    else:
      link(lst.first, empty)
    end
  else:
    if lst.first.char == A:
      link(word-letter(lst.first.char, true), update-word(lst.rest, A))
    else:
      link(lst.first, update-word(lst.rest, A))
    end
  end
end

fun update-letters(lst, A):
  if length(lst) <= 1: 
    if lst.first.char == A:
      link(letter(lst.first.char, true), empty)
    else:
      link(lst.first, empty)
    end
  else:
    if lst.first.char == A:
      link(letter(lst.first.char, true), update-letters(lst.rest, A))
    else:
      link(lst.first, update-letters(lst.rest, A))
    end
  end
end

data Letter-List:
  | word-letters(chars:: List) with:
    method update(self, A): word-letters(update-word(self.chars,A)) end,
    method display(self):
      fold(beside, empty-image,map(_.display(), self.chars))
    end
  | all-letters(chars:: List) with:
    method update(self, A): all-letters(update-letters(self.chars,A)) end,
    method display(self):
      above(above(
          fold(beside, empty-image,map(_.display(), self.chars.take(13))),
          rectangle(20, 3, "solid", "transparent")),
        fold(beside, empty-image,map(_.display(), self.chars.drop(13))))
    end
end

data Game-Data:
    game-data(
      HM       :: Hangman,
      word-raw :: List,
      word     :: Letter-List,
      letters  :: Letter-List
      )
end

