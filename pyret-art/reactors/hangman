############################################
# Drawing letters 

fun to-draw(state):
  clr = 
    if state.HM.status == 6: KO-CLR
    else if all(_ == true, map(_.visible, state.word.chars)): WN-CLR
    else: BG-CLR
  end
    
  put-image(
    state.HM.display(), 100, 99, put-image(
      state.word.display(), 372, 150, put-image(
        state.letters.display(), 400, 50, gallows(clr)
        )))
end

fun guess(state, key):
  k = string-to-upper(key)
  if member(letters-raw, string-to-upper(k)):
    if member(state.word-raw,k):
      game-data(
        state.HM,
        state.word-raw,
        state.word.update(k),
        state.letters.update(k)
        )
    else:
      game-data(
        state.HM.advance(),
        state.word-raw,
        state.word,
        state.letters.update(k)
        )
    end
  else:
    state
  end
end

fun on-tick(state):
  if state.HM.status == 6:
    game-data(
      state.HM,
      state.word-raw,
      word-letters(map(word-letter(_,true), state.word-raw)),
      all-letters(map(letter(_, true), letters-raw))
      )
  else:
    state
  end
end

