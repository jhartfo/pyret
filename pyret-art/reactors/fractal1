# subdivide segment into quaters with positions 
# (X0,Y0), (X1,Y1), (X2,Y2), (X3,Y3), (X4,Y4)
# replace X2 with XN = (Y1 - Y2) + X2
# replace Y2 with YN = (X2 - X1) + Y2

fun subdivide(pt0, pt4):
  pt2 = point((pt0.x + pt4.x) / 2, (pt0.y + pt4.y) / 2)
  pt1 = point((pt0.x + pt2.x) / 2, (pt0.y + pt2.y) / 2)
  pt3 = point((pt2.x + pt4.x) / 2, (pt2.y + pt4.y) / 2)
  
  ptN = point((pt2.y - pt1.y) + pt2.x, (pt1.x - pt2.x) + pt2.y)
  [list: pt0, pt1, ptN, pt3]
end
 
fun update(pt-list):
  list-l     = pt-list.take(length(pt-list) - 1)
  list-r     = pt-list.drop(1)
  last-elem  = pt-list.drop(length(pt-list) - 1)
    
  collection = map2(subdivide, list-l, list-r)
  flattened  = fold(append, empty, collection)
  
  append(flattened, last-elem)
end

