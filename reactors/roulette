use context starter2024

num-random-seed(6)

fun spin-cylinder(dumby):
  num-random(6) + 1
end

data HitPoints:
    hp(
      me       :: Number    , 
      boss     :: Number    )
end

data GameData:
    game-data(
      chamber  :: Number    ,
      cylinder :: Number    ,
      boom     :: Boolean   , 
      my-turn  :: Boolean   ,
      HP       :: HitPoints )
end

toggle :: Boolean -> Boolean
examples:
  toggle(false) is true
  toggle(true) is false
end
fun toggle(bool):
  not(bool)
end

hit-boss :: HitPoints -> HitPoints
examples: 
  hit-boss(hp(2,3)) is hp(2,2)
  hit-boss(hp(0,0)) is hp(0,-1)
end
fun hit-boss(h):
  hp(h.me, h.boss - 1)
end

hit-me :: (HitPoints -> HitPoints)
examples: 
  hit-me(hp(2,3)) is hp(1,3)
  hit-me(hp(0,0)) is hp(-1,0)
end
fun hit-me(h):
  hp(h.me - 1, h.boss)
end

