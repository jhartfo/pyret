### 2. Double the scene pieces

ROAD  = beside(RAWROAD , RAWROAD )
BUSH1 = beside(RAWBUSH1, RAWBUSH1)
BUSH2 = beside(RAWBUSH2, RAWBUSH2)
MTNS  = beside(RAWMTNS , RAWMTNS )
TREES = beside(RAWTREES, RAWTREES)

#####################################################

### 3. Define oncoming cars

# CAR2 :: Number -> Image
# consumes a number and returns the corresponding car Image
fun CAR2(n):
  if      n == 0: flip-horizontal(CAR1)
  else if n == 1: REDCAR
  else if n == 2: BLUECAR
  else if n == 3: YELLOWCAR  
  else:           empty-image
  end
end

#####################################################

### 4. A screenshot

SCREENSHOT = put-image(BUSH2 ,   0,  90,
  put-image(GRASS            ,   0,  30,
    put-image(CAR1           , 300, 130,
      put-image(CAR2(1)      , 800, 170,
        put-image(ROAD       ,   0, 100,
          put-image(BUSH1    ,   0, 175,
            put-image(TREES  ,   0, 225,
              put-image(MTNS ,   0, 375, 
                SKY))))))))

#####################################################

### 5. Scene Update functions
fun update-left(x,dx):
  if x >= -500: 
    x - dx
  else:
    1500
  end
end

fun update-right(x,dx):
  if x > 0: 
    x - dx
  else:
    2000
  end
end

fun update-mtns-posn(x): update-right(x,1) end
fun update-tree-posn(x): update-right(x,5) end
fun update-road-posn(x): update-right(x,10) end
fun update-cars-posn(x): update-left(x,20) end

fun update-car(R,x):
  if x == 1500:
    num-random(NUMCARS)
  else:
    R
  end
end
    
#####################################################

### 6. Build Reactor    
data Elements:
    elements(
      mx,my,tx,ty,cx,cy,rx,ry,b1x,b1y,b2x,b2y,R
      )
end

initial-posns = elements(
  2000,375,
  2000,275,
  2500,170,
  2000,100,
  2000,175,
  2000,90,
  0
  )

fun draw-scene(current):
  put-image(BUSH2                 , current.b2x, current.b2y,
    put-image(GRASS               , 0          ,  30        ,
      put-image(CAR1              , 500        , 130        ,
        put-image(CAR2(current.R) , current.cx , current.cy ,
          put-image(ROAD          , current.rx , current.ry ,
            put-image(BUSH1       , current.b1x, current.b1y,
              put-image(TREES     , current.tx , current.ty ,
                put-image(MTNS    , current.mx , current.my , 
                  SKY))))))))
end  

fun update-scene(current):
  elements(
    update-mtns-posn(current.mx) , current.my,
    update-tree-posn(current.tx) , current.ty,
    update-cars-posn(current.cx) , current.cy,
    update-road-posn(current.rx) , current.ry,
    update-road-posn(current.b1x), current.b1y,
    update-road-posn(current.b2x), current.b2y,
    update-car(current.R,current.cx)
    )
end

  
scene = reactor:
  init: initial-posns,
    to-draw: draw-scene,
  on-tick: update-scene
end

interact(scene)


