# product-list :: List, List -> List
examples:
  product-list(A ,p ) is map2(_ * _, A , p )
  product-list(wt,ht) is map2(_ * _, wt, ht)
end
fun product-list(x-list, y-list):
  map2(_ * _, x-list, y-list)
end

# nsr :: List, List -> Number
examples:
  nsr(A ,p ) is list-sum(product-list(A , p )) / (length(A ) - 1)
  nsr(wt,ht) is list-sum(product-list(wt, ht)) / (length(wt) - 1)
end
fun nsr(x-list, y-list):
  list-sum(product-list(x-list, y-list)) / (length(x-list) - 1)
end

# r :: List, List -> Number
examples:
  r(A, p ) is-roughly list-sum(product-list(z-scores(A ), z-scores(p ))) / (length(A ) - 1)
  r(wt,ht) is-roughly list-sum(product-list(z-scores(wt), z-scores(ht))) / (length(wt) - 1)
end
fun r(x-list, y-list):
  list-sum(product-list(z-scores(x-list), z-scores(y-list))) / (length(x-list) - 1)
end

# slope :: List, List -> Number
examples:
  slope( A, p ) is-roughly (stdDev(p ) / stdDev( A)) * r( A, p)
  slope(wt, ht) is-roughly (stdDev(ht) / stdDev(wt)) * r(wt,ht)
end
fun slope(x-list, y-list):
  (stdDev(y-list) / stdDev(x-list)) * r(x-list,y-list)
end

# y-int :: List, List -> Number
examples:
  y-int( A, p) is-roughly list-mean( p) - (list-mean( A) * slope( A, p))
  y-int(wt,ht) is-roughly list-mean(ht) - (list-mean(wt) * slope(wt,ht))
end
fun y-int(x-list, y-list):
  list-mean(y-list) - (list-mean(x-list) * slope(x-list, y-list))
end

#|
X           = [list: 60, 55, 50, 47, 42,39, 32]
Y           = [list: 1000, 800, 700, 600, 430, 400, 300]
M           = slope(X,Y)
B           = y-int(X,Y)

# y-hat :: Number -> Number
fun y-hat(x): 
  (M * x) + B 
end

# base-line-model :: Number -> Number
fun base-line-model(x): 
  list-mean(Y)
end
y-hat-values       = map(y-hat, X)
baseline-values    = map(base-line-model, X)

y-hat-residuals    = map2(_ - _, Y, y-hat-values)
baseline-residuals = map2(_ - _, Y, baseline-values)
|#
fun percent-change(a,b):
  (a - b) / a
end

#|
SSR-y-hat    = list-sqr-sum(y-hat-residuals)
SSR-baseline = list-sqr-sum(baseline-residuals)

r(X,Y)
r2 = percent-change(SSR-baseline, SSR-y-hat)
r2
|#

# tri-num :: Number -> Number
# consumes a number, creates a list of interger
# from 1 to the number and produces the sum of the list
examples:
  tri-num( 3) is list-sum(arithmetic(1, 4,1))  
  tri-num(13) is list-sum(arithmetic(1,14,1)) 
end
fun tri-num(n): list-sum(arithmetic(1,n + 1,1))
end

# factorial :: Number -> Number
# consumes a number, creates a list of interger
# from 1 to the number and produces the product of the list
examples:
  list-factorial( 3) is list-product(arithmetic(1, 4,1))  
  list-factorial(13) is list-product(arithmetic(1,14,1)) 
end
fun list-factorial(n): list-product(arithmetic(1,n + 1,1))
end










