rands2  = lam(s): num-random(70) +  40 end
rands3  = lam(s): num-random(70) +  60 end
rands4  = lam(s): num-random(70) +  80 end
randc   = lam(c): rand-color(num-random(4)) end
  
rnge = range(0,8)

rand-x1 = map(randx , rnge)
rand-y1 = map(randy1, rnge)
rand-s1 = map(rands1, rnge)
rand-c1 = map(randc , rnge)
ctrees1 = map2(c-tree, rand-s1, rand-c1)

rand-x2 = map(randx , rnge)
