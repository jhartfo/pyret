use context essentials2021

fun ys(s):
  star(s, "solid", "yellow")
end
fun gt(s, c):
  triangle(s, "solid",c)
end
fun br(s):
  rectangle(s, s  * 3, "solid", "brown")
end
fun c-tree(s,c):
  above(ys(s / 2), 
    above(gt(s / 2, c),
        above(gt(s / 1.5,c),
          above(gt(s,c), br(s / 4)))))
end
fun rand-color(n):
  if n == 0 : "olive"
  else if n == 1 : "darkgreen"
  else if n == 2 : "forestgreen"
  else: "green"
  end
end

bg = above(
  rectangle(700, 350, "solid", "lightblue"),
  rectangle(700, 360, "solid", "white")
  )

randx   = lam(x): num-random(700) + 0 end
randy1  = lam(y): num-random(90) + 300 end
randy2  = lam(y): num-random(90) + 250 end
randy3  = lam(y): num-random(90) + 150 end
