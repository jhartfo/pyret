fun reverse-put-image(bs, x,y, im):
  put-image(im, x,y,bs)
end

l1 = fold3(reverse-put-image, bg, rand-x1,rand-y1,ctrees1)
l2 = fold3(reverse-put-image, l1, rand-x2,rand-y2,ctrees2)
l3 = fold3(reverse-put-image, l2, rand-x3,rand-y3,ctrees4)
