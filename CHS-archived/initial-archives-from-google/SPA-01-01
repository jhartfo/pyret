import lists as L
import chart as C


fun count-if(a-list, value):
  length(L.filter(lam(x): x == value end, a-list))
end
  
fun frequency-table(a-list):
  categories  = 
    if length(L.filter(is-boolean, a-list)) > 0:
      distinct(a-list)
    else:
      L.sort(distinct(a-list))
    end
  frequencies = map(lam(x): count-if(a-list, x ) end, categories)
  relative = map(lam(x): x / length(a-list) end,frequencies)
  [table-from-columns:
    {"Values"     ; categories},
    {"Freq."      ; frequencies},
    {"Rel. Freq." ; relative},
  ]
end

fun table-frequency-table(tbl, col):
  variable = tbl.get-column(col)
  frequency-table(variable)
end

