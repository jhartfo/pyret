data Vector:
    vector(elements:: List) with:
    method dot(self, other): sum(map2(_ * _, self.elements, other.elements)) end,
    method add(self, other): vector(map2(_ + _, self.elements, other.elements)) end,
    method sub(self, other): vector(map2(_ - _, self.elements, other.elements)) end,
    method magnitude(self): num-sqrt(self.dot(self)) end
end

data SquareMatrix:
    matrix(rows:: List) with:
    method dim(self): length(self.rows) end,
    method get-col-n(self,n): vector(map(lam(x): x.get(n) end, self.rows)) end,
    method get-row-n(self,n): vector(self.rows.get(n)) end,
    method add(self, other): 
      matrix(
        map(lam(x): self.get-row-n(x).add(other.get-row-n(x)).elements end,
        range(0,self.dim()))) end,
    method sub(self, other): 
      matrix(
        map(lam(x): self.get-row-n(x).sub(other.get-row-n(x)).elements end,
        range(0,self.dim()))) end,
    method scale(self): 0 end,
    method mult(self): 0 end,
end
