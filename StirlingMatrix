fun S1(n,k):
  if n == k: 1
  else if (n == 0) or (k == 0): 0
  else: S1(n - 1, k - 1) + ((n - 1) * S1(n - 1, k))
  end
end


fun S2(n,k):
  if n == k: 1
  else if (n == 0) or (k == 0): 0
  else: S2(n - 1, k - 1) + (k * S2(n - 1, k))
  end
end

fun S1s(n,k):
  value = 
    if n == k: 1
    else if (n == 0) or (k == 0): 0
    else: S1(n - 1, k - 1) + ((n - 1) * S1(n - 1, k))
  end
  value * num-expt(-1, n - k)
end


fun S2M(n):
  row = lam(x): map(lam(y): S2(y - 1, x) end, range(1,n + 1)) end
  map(row, range(0,n))
end
  
fun S1M(n):
  row = lam(x): map(lam(y): S1s(y - 1, x) end, range(1,n + 1)) end
  map(row, range(0,n))
end

fun SPM(n):
  fun ele(i,j):
  sum(
    map(
        lam(k): S2(i - 1, k - 1) * S1s(k - 1, j - 1)  end ,
      range(1,n + 1)))
  end
  
  row = lam(x): map(lam(y): ele(x,y) end, range(1,n + 1)) end
  map(row, range(1,n + 1))
  
end

fun SPM2(n):
  fun ele(i,j):
  sum(
    map(
        lam(k): S1s(i - 1, k - 1) * S2(k - 1, j - 1)  end ,
      range(1,n + 1)))
  end
  
  row = lam(x): map(lam(y): ele(x,y) end, range(1,n + 1)) end
  map(row, range(1,n + 1))
  
end


