fun percentile(lst, X):
  l = list-sort(lst, true)
  N = length(lst) - 1
  pos = N * X
  wt = pos - num-floor(pos)
  a = element-n(l,num-floor(pos))
  b = element-n(l,num-ceiling(pos))
  a + ((b - a) * wt)
end
   
