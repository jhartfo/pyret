fun unsafe-string-to-number(x):
  string-to-number(x).value
end

fun find-i(big-number, num-digits) block:
  str               = num-to-string(number)
  n                 = string-length(str)
  var final-prod    = 0
  var I             = 0

  for each(i from range(0,n - num-digits)) block:
  
  indices = map(_ + i, range(0,num-digits))
  digits  = map(
    lam(x): 
      unsafe-string-to-number(string-char-at(str,x)) 
    end, 
    indices)
  
    prod-i = fold(_ * _, 1, digits)
  
    I := if prod-i > final-prod: 
      i
    else:
      I
    end
  
  final-prod   := if prod-i > final-prod: 
    prod-i
  else:
    final-prod
  end 
end
  I
end

fun build-digits(big-number, i, len):
  str     = num-to-string(number)
  map(lam(x):unsafe-string-to-number(string-char-at(str, x)) end,
    range(i,i + len))
end

fun product(lst):
  fold(_ * _, 1, lst) 
end

final-i    = find-i(number, 13)
digits     = build-digits(number, final-i, 13)
final-prod = product(digits)

