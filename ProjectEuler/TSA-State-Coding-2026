fun fibb(a1,a2,n):
  fun fibb-builder(s1,s2,s,e):
    if s >= e: empty
    else:
      link(s1, fibb-builder(s2, s1 + s2, s + 1, e))
    end 
  end
  fibb-builder(a1,a2,0,n)
end
  
fun fibb-less-than(a1,a2,n):
  if (a1 + a2) >= n : empty
  else:
    link(a1,even-fibb-less-than(a2, a1 + a2, n))
  end
end

fun even-fibb-less-than(a1,a2,n):
  if (a1 + a2) >= n : empty
  else:
    if num-modulo(a1,2) == 0:
      link(a1,even-fibb-less-than(a2, a1 + a2, n))
    else:
      even-fibb-less-than(a2, a1 + a2, n)
    end
  end
end

