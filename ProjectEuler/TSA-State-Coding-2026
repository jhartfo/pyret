fun order-summary(tbl):
  order-items  = list-to-set(tbl.get-column("item")).to-list()
  order-names  = map(lam(x): x.name end, order-items)
  order-counts = 
    map(
      lam(x): tbl.filter(lam(r): r["name"] == x end).length() end, 
      order-names)
  [table-from-columns:
    {"item" ; order-items}, 
    {"name" ; order-names},
    {"count"; order-counts}]
    .build-column("unit-price", lam(r): r["item"].price end)
    .build-column("price", lam(r): r["item"].price * r["count"] end)
end

fun total-price(tbl):
  sum(tbl.get-column("price"))
end

fun recipe-lines(tbl):
  order-summary(tbl)
    .build-column("line", lam(r): 
      num-to-string(r["count"]) + " " + r["name"] + " @" + 
      num-to-string(r["unit-price"]) + " . . . " +
      num-to-string(r["price"])
    end)
    .build-column("line-image", lam(r): text(r["line"], 50, "black") end)
    .get-column("line-image")
end


fun update-menu(state, key):
  if      key == "h": add-hamburger(state)
  else if key == "d": add-hotdog(state)
  else if key == "t": add-taco(state)
  else:
    state
  end
end
        
fun draw-menu(state):
  above(
    text("my restaurant", 50, "black"), above(
      rectangle(600,2,"solid", "black"), above(
        fold(above, empty-image,recipe-lines(state)), above(
            rectangle(600,2,"solid", "black"),
              text(num-to-string(total-price(state)), 50, "black")
          ))))
end

