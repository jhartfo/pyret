do_ :: Number -> String
fun do_(x):
  if num-modulo(x,DO) == 0: "do "
  else: ""
  end
end

re_ :: Number -> String
fun re_(x):
  if num-modulo(x,RE) == 0: "re "
  else: ""
  end
end

mi_ :: Number -> String
fun mi_(x):
  if num-modulo(x,MI) == 0: "mi "
  else: ""
  end
end

do-re-mi-1 :: Number -> String
fun do-re-mi-1(x):
  do_(x) + re_(x) + mi_(x)
end

do-re-mi-2 :: Number -> String
fun do-re-mi-2(x):
  ask: 
    | num-modulo(x,3) == 0 then: "do"
    | num-modulo(x,5) == 0 then: "re"
    | num-modulo(x,6) == 0 then: "mi"
    | otherwise: num-to-string(x)
  end
end


