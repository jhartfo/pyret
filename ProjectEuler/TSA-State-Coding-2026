data Label: 
    lbl(
      guess     :: String,
      response  :: String,
      remaining :: String
      ) with:
  method display-guess(self)    : text(self.guess    , 50, "black") end,
  method display-response(self) : text(self.response , 50, "black") end,
  method display-remaining(self): text(self.remaining, 50, "black") end,
end
    
data GuessingData:
    g-data(
      display-level :: Number,
      secret        :: Number,
      my-guess      :: Number,
      guesses-left  :: Number,
      labels :: Label
      )
end

data GuessData:
  |guess-pair(secret:: Number, guess:: Number) with:
    method is-correct(self)  : self.guess == self.secret end,
    method is-too-big(self)  : self.guess >  self.secret end,
    method is-too-small(self): self.guess <  self.secret end
    
  |guess-data(secret:: Number, guess-list:: List, level:: Number) with:
    method guess(self): 
    string-to-number(self.guess-list.join-str("")).value end,
    method is-correct(self)  : self.guess() == self.secret end,
    method is-too-big(self)  : self.guess() >  self.secret end,
    method is-too-small(self): self.guess() <  self.secret end
    
end 

    
is-correct:: GuessingData -> Boolean
fun is-correct(state):
  if state.secret == state.my-guess: true
  else: false
  end
end

is-too-big:: GuessingData -> Boolean
fun is-too-big(state):
  if state.secret < state.my-guess: true
  else: false
  end
end

is-too-small:: GuessingData -> Boolean
fun is-too-small(state):
  if state.secret > state.my-guess: true
  else: false
  end
end

