# list-count :: List, Any, -> Number
# consumes a List and a Value and produces the
# Number of occurences of the given value in the List
examples:
  list-count([list:], 1)                  is 0
  list-count([list:2], 1)                 is 0
  list-count([list:1], 1)                 is 1
  list-count([list:1,2,1], 1)             is 2
  list-count([list:1,2,3], "a")           is 0
  list-count([list:"ab", "a", "b"], "ab") is 1
end
fun list-count(lst, v):
  length(filter(_ == v, lst))
end

is-anagram:: String, String -> Boolean
# consumes two Strings. To speed up the process,
# we provide several off ramps. First, is there
# is normal String equality then they are 
# obviously anaframs. Second, if they are not
# composed of the same letters, then they 
# obviously not anagrams.
#
# Once we have matching Lists of characters
# get the counts of those character from each
# List. If the counts match then return true
# otherwise, false
examples:
  is-anagram("", "")        is true
  is-anagram("cat", "cat")  is true
  is-anagram("act", "cat")  is true
  is-anagram("cat", "act")  is true
  is-anagram("cat", "cta")  is true
  is-anagram("cat", "act")  is true
  is-anagram("cat", "atc")  is true
  is-anagram("cat", "tac")  is true
  is-anagram("cat", "tca")  is true
  is-anagram("cat", "at" )  is false
  is-anagram("cat", "cats") is false
end
fun is-anagram(A,B):
  
  # if they are straight up the same
  # thing, take the win and move on.
  if A == B: 
    true # and we are done
    
  # otherwise, we need to
  else:
    # make a list of unique characters 
    # in the string
    A-chars = list-to-set(string-explode(A)).to-list().sort()
    B-chars = list-to-set(string-explode(B)).to-list().sort()
    
    # if they are straight up different
    # things, take the win and move on.
    if A-chars <> B-chars: 
      false # and we are done
    
    # otherwise, A-chars and B-chars are the same,
    # so we'll just use at A-chars going forward.
    else:
      # we need to make a list of character frequencies,
      A-counts = map(list-count(string-explode(A),_), A-chars)
      B-counts = map(list-count(string-explode(B),_), B-chars)
      
      # and see if those frequencies are the same.
      A-counts == B-counts
    end
  end
end

fun is-a-2(A,B):
  string-explode(A).sort() == string-explode(B).sort()
end


