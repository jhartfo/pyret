is-palindrome :: String -> Boolean
# consumes a string and recursively compares the 
# first and last character. If all pairs are the same,
# we have a palindrome. Single characters and no characters
# default to true
examples:
  is-palindrome("") is true
  is-palindrome("a") is true
  is-palindrome("abcdcba") is is-palindrome("bcdcb")
end

fun is-palindrome(word):
  
  # first we create a list containing are the characters 
  # so we can compare the characters. For convenience, we 
  # also defined the len as the length of the list
  char-list = string-explode(word)
  len       = length(char-list)
  
  # base case:
  if len < 2 : 
    true
    
  # if the first and last elements are not equal, 
  # we are done. return false
  else if char-list.get(0) <> char-list.get(len - 1):
    false
  
  # otherwise, we remove the first and last elements,
  # rejoin the string, and continue checking pairs of characters
  else:
    is-palindrome(char-list.take(len - 1).drop(1).join-str(""))
  end
end


