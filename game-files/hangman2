use context starter2024
include reactors

data Hangman:
  |hangman(
      head      :: String,
      body      :: String,
      left-arm  :: String,
      right-arm :: String,
      left-leg  :: String,
      right-leg :: String
      )
end

data Letter:
    letter(
      char    :: String,
      visible :: Boolean
      ) with:
    method display(self):
      clr = if self.visible == true: "white" else: "black" end
      beside(
        overlay-align("center", "center",
          text(self.char, 20, "black"),
          square(20, "solid", clr)
          ),
        rectangle(3,20,"solid","white"))
    end,
end

data Game:
    game(
      HM      :: Hangman,
      word    :: String,
      letters :: List)
end

fun head(clr):
  circle(25, "solid", clr)
end

fun body(clr):
  square(50, "solid", clr)
end

fun leg(clr):
  rectangle(5, 50, "solid", clr)
end

fun arm(clr):
  rectangle(50, 5, "solid", clr)
end

fun draw-hangman(HM):
  above(
    head(HM.head), above(
      beside(arm(HM.left-arm), beside(body(HM.body), arm(HM.right-arm))),
      beside(leg(HM.left-leg), beside(leg("white"), leg(HM.right-leg))))
    )
end

fun draw-game(state):
  beside(
    draw-hangman(state.HM),
    fold(beside, empty-image, map(_.display(), state.letters))
    )
end

fun advance-hangman(state):
  if state.HM.head == "white": 
    hangman("black","white","white","white","white","white")
  else if state.HM.body == "white": 
    hangman("black","black","white","white","white","white")
  else if state.HM.left-arm == "white": 
    hangman("black","black","black","white","white","white")
  else if state.HM.right-arm == "white": 
    hangman("black","black","black","black","white","white")
  else if state.HM.left-leg == "white": 
    hangman("black","black","black","black","black","white")
  else: 
    hangman("black","black","black","black","black","black")
  end
end

fun update-one-letter(ltr, key):
  if ltr.char == key: 
    letter(ltr.char, true)
  else:
    ltr
  end
end

fun update-letters(state, key):
  map(update-one-letter(_, key), state.letters)
end

fun update-key(state, key):
  if string-contains("abcdefghijklmnopqrstuvwxyz", key):
    if not(string-contains(state.word, key)):
      game(
        advance-hangman(state),
        state.word,
        state.letters)
    else: 
      game(
        state.HM,
        state.word,
        update-letters(state, key))
    end
  else:
    state
  end
end

secret-word   = "ability"
start-HM      = hangman("white","white","white","white","white","white")
start-letters = map(letter(_, false), string-split-all(secret-word,""))
start-game    = game(start-HM, secret-word, start-letters)


