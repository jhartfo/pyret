fun progress(s):
  text(([list: num-to-string(num-abs(num-round(s.fl.r / 10))), "ft"].join-str(" ")), 24, "olive")
end

fun room1(s):
  scr = put-image(floor, 350, s.fl.r, bkr)
  b   = put-image(plt, s.levels.P1.x, s.levels.P1.y, scr)
  c   = put-image(plt, s.levels.P2.x, s.levels.P2.y, b)
  d   = put-image(plt, s.levels.P3.x, s.levels.P3.y, c)
  e   = put-image(plt, s.levels.P4.x, s.levels.P4.y, d)
  f   = put-image(plt, s.levels.P5.x, s.levels.P5.y, e)
  g   = put-image(progress(s), 40, 470, f)
  
  if (s.plr == 1):
    if (s.onf == 0):
      put-image(plupr, s.pos.x, s.pos.y, g)
    else:
      put-image(plright, s.pos.x, s.pos.y, g)
    end
  else if (s.pll == 1):
    if (s.onf == 0):
      put-image(plupl, s.pos.x, s.pos.y, g)
    else:
      put-image(plleft, s.pos.x, s.pos.y, g)
    end
  else:
    put-image(plright, s.pos.x, s.pos.y, g)
  end
end

fun onclick(s, x, y, click):  
  if (click == "button-down") and (s.onf == 1):
    plr(
      s.pos, 
      (s.v - s.v) + 16, s.onf - 1, s.scp, s.pll, s.plr, 
      s.plu, s.pld, s.stp, s.t, 
      s.levels,
      s.fl)
  else:
    s
  end
end

fun onkey(s, key):
  if (key == "d"):
    right(s)
  else if (key == "a"):
    left(s)
  else:
    s
  end
end

