fun scroll-helper-1(s):
  platform(      
    point(s.levels.P1.x,s.levels.P1.y - 1),
    point(s.levels.P2.x,s.levels.P2.y - 1),
    point(s.levels.P3.x,s.levels.P3.y - 1),
    point(s.levels.P4.x,s.levels.P4.y - 1),
    point(s.levels.P5.x,s.levels.P5.y - 1))
end

fun scroll-helper-2(s):
  p1 = if (s.levels.P1.y < -9):
    point(ran(1) ,s.levels.P1.y + 500)
  else: s.levels.P1
  end
  p2 = if (s.levels.P2.y < -9):
    point(ran(1) ,s.levels.P2.y + 500)
  else: s.levels.P2
  end
  p3 = if (s.levels.P3.y < -9):
    point(ran(1) ,s.levels.P3.y + 500)
  else: s.levels.P3
  end
  p4 = if (s.levels.P4.y < -9):
    point(ran(1) ,s.levels.P4.y + 500)
  else: s.levels.P4
  end
  p5 = if (s.levels.P5.y < -9):
    point(ran(1) ,s.levels.P5.y + 500)
  else: s.levels.P5
  end
  platform(p1,p2,p3,p4,p5)
end
  
fun scroll-helper-3(s):
  p1 = point(s.levels.P1.x,s.levels.P1.y - s.v)
  p2 = point(s.levels.P2.x,s.levels.P2.y - s.v)
  p3 = point(s.levels.P3.x,s.levels.P3.y - s.v)
  p4 = point(s.levels.P4.x,s.levels.P4.y - s.v)
  p5 = point(s.levels.P5.x,s.levels.P5.y - s.v)
  platform(p1,p2,p3,p4,p5)
end

fun left(s):
  plr(
    point(s.pos.x - 10, s.pos.y), 
    s.v, s.onf, s.scp, (s.pll - s.pll) + 1, s.plr - 1, 
    s.plu, s.pld, s.stp, s.t, 
    s.levels,
    s.fl)
end

fun right(s):
  plr(
    point(s.pos.x + 10, s.pos.y), 
    s.v, s.onf, s.scp, s.pll - 1, (s.plr - s.plr) + 1, 
    s.plu, s.pld, s.stp, s.t, 
    s.levels,
    s.fl)
end

fun scroll(s, x, y, p):
  if (s.pos.y > 350):
    plr(
      point(s.pos.x, s.pos.y - 1), 
      s.v, s.onf, s.scp, s.pll, s.plr, 
      s.plu, s.pld, s.stp, s.t, 
      scroll-helper-1(s),
      flr(s.fl.r - 1, s.fl.d))
  else:
    s
  end
end

fun ends(s):
