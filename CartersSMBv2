end

fun scroll(s, x, y, p):
  if (s.pos.y > 350):
    plr(
      point(s.pos.x, s.pos.y - 1), 
      s.v, s.onf, s.scp, s.pll, s.plr, 
      s.plu, s.pld, s.stp, s.t, 
      point(s.pl1.x,s.pl1.y - 1),
      point(s.pl2.x,s.pl2.y - 1),
