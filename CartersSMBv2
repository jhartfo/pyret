fun progress(s):
  text(([list: num-to-string(num-abs(num-round(s.flr / 10))), "ft"].join-str(" ")), 24, "olive")
end

fun room1(s):
  scr = put-image(floor, 350, s.flr, bkr)
  b   = put-image(plt, s.pl1.x, s.pl1.y, scr)
  c   = put-image(plt, s.pl2.x, s.pl2.y, b)
  d   = put-image(plt, s.pl3.x, s.pl3.y, c)
  e   = put-image(plt, s.pl4.x, s.pl4.y, d)
  f   = put-image(plt, s.pl5.x, s.pl5.y, e)
  g   = put-image(progress(s), 40, 470, f)
  
  if (s.plr == 1):
    if (s.onf == 0):
      put-image(plupr, s.pos.x, s.pos.y, g)
    else:
      put-image(plright, s.pos.x, s.pos.y, g)
    end
  else if (s.pll == 1):
    if (s.onf == 0):
      put-image(plupl, s.pos.x, s.pos.y, g)
    else:
      put-image(plleft, s.pos.x, s.pos.y, g)
    end
  else:
    put-image(plright, s.pos.x, s.pos.y, g)
  end
end

fun onclick(s, x, y, click):  
  if (click == "button-down") and (s.onf == 1):
    plr(
      s.pos, 
      (s.v - s.v) + 16, s.onf - 1, s.scp, s.pll, s.plr, 
      s.plu, s.pld, s.stp, s.t, 
      s.pl1, s.pl2, s.pl3, s.pl4, s.pl5, 
      s.flr, s.fld)
  else:
    s
  end
end

fun onkey(s, key):
  if (key == "d"):
    right(s)
  else if (key == "a"):
    left(s)
  else:
    s
  end
end

